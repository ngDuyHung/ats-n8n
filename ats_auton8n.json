    {
      "parameters": {
        "jsCode": "let candidates = $input.all();\nlet quota = $('Webhook1').item.json.body.so_luong_tuyen || 1; \n\ncandidates.sort((a, b) => b.json.result.score - a.json.result.score);\n\nfor (let i = 0; i < candidates.length; i++) {\n  if (i < quota) {\n    candidates[i].json.ket_qua_cuoi = \"PASSED\"; // Đổi chuẩn Tiếng Anh\n  } else {\n    candidates[i].json.ket_qua_cuoi = \"FAILED\"; // Đổi chuẩn Tiếng Anh\n  }\n}\n\nreturn candidates;"
      },
